"""
ESG Carbon Calculator — CLI (콘솔 인터페이스)

계산 엔진과 입출력이 완전히 분리된 CLI 레이어입니다.
"""

import json
import sys

from esg_calculator.engine import ESGCarbonCalculator
from esg_calculator.species_db import list_species, is_registered_species
from esg_calculator.validators import ValidationError
from esg_calculator.emission_factors import EmissionFactorNotFoundError


def print_separator(char: str = "=", width: int = 60) -> None:
    print(char * width)


def print_header(title: str, width: int = 60) -> None:
    print()
    print_separator("=", width)
    print(f" {title} ")
    print_separator("=", width)


def safe_float_input(prompt: str, allow_empty: bool = False) -> float | None:
    """안전한 float 입력 (빈 값 허용 옵션)"""
    value = input(prompt).strip()
    if allow_empty and value == "":
        return None
    return float(value)


def safe_int_input(prompt: str) -> int:
    """안전한 int 입력"""
    return int(input(prompt).strip())


def format_report(report: dict) -> None:
    """Net Zero 리포트를 포맷하여 출력합니다."""
    emissions = report["emissions"]
    offsets = report["offsets"]
    summary = report["summary"]
    meta = report["meta"]

    print_header("기업 온실가스 인벤토리 및 순 배출량(Net Zero) 리포트")

    # 메타 정보
    print(f"  📍 국가: {meta['country']}  |  📅 기준연도: {meta['year']}")
    print(f"  📋 방법론: {', '.join(meta['methodology'][:2])}")
    print_separator("-")

    # [1] 배출량
    print("\n[1] 온실가스 배출 내역 (Emissions)")
    s1 = emissions["scope1"]
    s2 = emissions["scope2"]
    s3 = emissions["scope3"]
    print(f"  Scope 1 (직접 배출)      : {s1['total_kgCO2eq']:>12,.2f} kgCO₂eq")
    if s1["breakdown"]["gasoline_kgCO2eq"] > 0:
        print(f"    └ 휘발유               : {s1['breakdown']['gasoline_kgCO2eq']:>12,.2f}")
    if s1["breakdown"]["diesel_kgCO2eq"] > 0:
        print(f"    └ 디젤                 : {s1['breakdown']['diesel_kgCO2eq']:>12,.2f}")
    if s1["breakdown"]["lng_kgCO2eq"] > 0:
        print(f"    └ LNG                  : {s1['breakdown']['lng_kgCO2eq']:>12,.2f}")
    print(f"  Scope 2 (간접 - 전력)    : {s2['total_kgCO2eq']:>12,.2f} kgCO₂eq")
    print(f"  Scope 3 (기타 - 폐기물)  : {s3['total_kgCO2eq']:>12,.2f} kgCO₂eq")
    print_separator("-")
    print(f"  ▶ 총 배출량              : {emissions['total_emissions_kgCO2eq']:>12,.2f} kgCO₂eq")

    # [2] 상쇄량
    print(f"\n[2] 탄소 상쇄 내역 (Offsets) — 연간 흡수량 기준")
    print(f"  등록 수목 수량           : {offsets['total_trees_count']:>12,} 그루")

    if offsets["tree_details"]:
        print()
        for i, tree in enumerate(offsets["tree_details"], 1):
            est_mark = " (추정)" if tree["height_estimated"] else ""
            print(
                f"  #{i} {tree['species']} × {tree['quantity']:,}그루 "
                f"| DBH {tree['dbh_cm']}cm, H {tree['height_m']}m{est_mark}"
            )
            print(
                f"      → 연간 {tree['annual_absorption_per_tree_kgCO2']:.4f} "
                f"kgCO₂/그루 × {tree['quantity']:,} = "
                f"{tree['annual_absorption_group_kgCO2']:,.4f} kgCO₂/년"
            )
            print(
                f"      → (참고) 총 저장량: {tree['carbon_stock_group_kgCO2']:,.2f} kgCO₂"
            )

    print_separator("-")
    print(f"  ▶ 연간 총 흡수량         : {offsets['annual_absorption_kgCO2']:>12,.2f} kgCO₂/년")
    print(f"  ▶ (참고) 총 탄소 저장량  : {offsets['total_carbon_stock_kgCO2']:>12,.2f} kgCO₂")

    # [3] 최종 결과
    print_separator("=")
    print("[최종 순 배출량] (Net Carbon Footprint)")
    print(f"  총 배출량                : {summary['total_emissions_kgCO2eq']:>12,.2f} kgCO₂eq/년")
    print(f"  연간 상쇄량              : {summary['annual_offset_kgCO2']:>12,.2f} kgCO₂/년")
    print_separator("-")
    print(f"  ★ 순 배출량              : {summary['net_emissions_kgCO2eq']:>12,.2f} kgCO₂eq/년")

    if summary["offset_rate_percent"] is not None:
        print(f"  ★ 상쇄율                 : {summary['offset_rate_percent']:>11.2f}%")

    if summary["carbon_neutral_achieved"]:
        print("\n  🎉 탄소 중립(Carbon Neutral) 달성!")
    else:
        gap = summary["net_emissions_kgCO2eq"]
        print(f"\n  ⚠️  탄소 중립까지 추가 {gap:,.2f} kgCO₂/년 상쇄 필요")

    print_separator("=")
    print()


def main():
    print_header("기업 ESG 온실가스 & 탄소 상쇄(Net Zero) 데이터 입력")

    try:
        # ── 국가/연도 설정 ───────────────────────────────────
        print("\n[0. 기본 설정]")
        country_input = input("▶ 국가 코드 (KR/US/JP/EU) [기본: KR] : ").strip().upper()
        country = country_input if country_input else "KR"

        year_input = input("▶ 배출계수 기준 연도 [기본: 2023] : ").strip()
        year = int(year_input) if year_input else 2023

        calculator = ESGCarbonCalculator(country=country, year=year)

        # ── 배출량 입력 ──────────────────────────────────────
        print("\n[1. 온실가스 배출량 기초 데이터 입력]")
        gasoline_l = float(input("▶ 법인차량 휘발유 총 사용량 (L)  : "))
        diesel_l_input = input("▶ 법인차량 디젤 총 사용량 (L)    [없으면 Enter] : ").strip()
        diesel_l = float(diesel_l_input) if diesel_l_input else 0.0
        lng_nm3 = float(input("▶ 난방/보일러 LNG 총 사용량 (Nm³): "))
        electricity_kwh = float(input("▶ 사업장 총 전력 사용량 (kWh)    : "))
        waste_ton = float(input("▶ 사업장 폐기물 발생량 (ton)     : "))

        emissions_data = {
            "gasoline_l": gasoline_l,
            "diesel_l": diesel_l,
            "lng_nm3": lng_nm3,
            "electricity_kwh": electricity_kwh,
            "waste_ton": waste_ton,
        }

        # ── 수목 데이터 입력 ─────────────────────────────────
        print("\n[2. 상쇄(Offset)를 위한 사내 조경 수목 데이터 입력]")
        print("💡 같은 종류의 나무를 '그룹'으로 묶어서 등록합니다.")
        print(f"📋 등록된 수종: {', '.join(list_species())}")

        group_count = safe_int_input(
            "\n▶ 등록할 수목의 '그룹(종류)' 개수 (0이면 없음) : "
        )

        trees_data = []
        for i in range(group_count):
            print(f"\n--- 수목 그룹 #{i + 1} ---")

            species = input("   수종명 (예: 소나무, 왕벚나무) : ").strip()
            if not species:
                species = "소나무"

            if not is_registered_species(species):
                print(f"   ⚠️  '{species}'은(는) 미등록 수종입니다. 기본 파라미터를 적용합니다.")

            quantity = safe_int_input(f"   {species}을(를) 몇 그루 심었습니까? : ")
            dbh = float(input("   평균 흉고직경 또는 직경 (cm) : "))

            height_m = safe_float_input(
                "   평균 수고(높이) (m) [모르면 Enter → 자동 추정] : ",
                allow_empty=True,
            )

            if height_m is None:
                est = calculator.estimate_height(species, dbh)
                height_m = est["estimated_height_m"]
                print(
                    f"   ✅ 수고 자동 추정: {height_m:.2f} m "
                    f"(Näslund 모형, a={est['parameters_used']['a']}, "
                    f"b={est['parameters_used']['b']})"
                )

            trees_data.append({
                "species": species,
                "quantity": quantity,
                "dbh_cm": dbh,
                "height_m": height_m,
            })

        # ── 리포트 생성 ──────────────────────────────────────
        print("\n⏳ 데이터를 취합하여 Net Zero 리포트를 생성 중...\n")

        report = calculator.generate_report(
            emissions_data=emissions_data,
            trees_data=trees_data,
        )

        format_report(report)

        # JSON 저장 옵션
        save_input = input("📁 결과를 JSON 파일로 저장하시겠습니까? (파일명 입력 / Enter=건너뛰기) : ").strip()
        if save_input:
            if not save_input.endswith(".json"):
                save_input += ".json"
            with open(save_input, "w", encoding="utf-8") as f:
                json.dump(report, f, ensure_ascii=False, indent=2)
            print(f"✅ 저장 완료: {save_input}")

    except ValidationError as e:
        print(f"\n❌ 입력값 검증 오류: {e}")
    except EmissionFactorNotFoundError as e:
        print(f"\n❌ 배출계수 오류: {e}")
    except ValueError:
        print("\n❌ 입력 오류: 사용량, 직경, 수고, 수량은 반드시 '숫자'만 입력해 주세요.")
    except KeyboardInterrupt:
        print("\n\n👋 프로그램이 종료되었습니다.")
    except Exception as e:
        print(f"\n❌ 알 수 없는 오류: {e}")


if __name__ == "__main__":
    main()
